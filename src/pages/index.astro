---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { socials } from '../utils/socials';
import { featuredProjects } from '../data/projects';
import { resumeUrl } from '../utils/site';

const stats = [
  { value: '1,000+', label: 'DSA problems solved' },
  { value: '2,100+', label: 'GitHub commits' },
  { value: '6', label: 'Products shipped' },
  { value: '8.27', label: 'CGPA · IIT Madras' },
];

const profile = [
  { key: 'Name', value: 'Awadh Kishor Singh' },
  { key: 'Alias', value: 'imawadh · im_awadh_' },
  { key: 'Role', value: 'Full Stack Developer' },
  { key: 'Education', value: 'BS Data Science, IIT Madras' },
  { key: 'Based', value: 'Bengaluru, India · Remote-friendly' },
  { key: 'Stack', value: 'React · Next.js · Node.js · Express · MongoDB · PostgreSQL' },
  { key: 'Recently', value: 'Full Stack Developer Intern, IAVerse' },
];
---

<PageLayout
  title="Awadh Kishor Singh | Full Stack Developer"
  description="Awadh Kishor Singh — Full Stack Developer in Bengaluru building production-ready web apps with React, Next.js, Node.js, and REST APIs. Data Science undergraduate at IIT Madras."
>
  <!-- ───────────── HERO ───────────── -->
  <section class="wrap pt-14 md:pt-24">
    <div class="grid gap-12 md:grid-cols-[1.6fr_1fr] md:items-start md:gap-16">
      <!-- LEFT: headline -->
      <div>
        <span class="eyebrow reveal reveal-1">Portfolio &mdash; 2026</span>

        <h1 class="reveal reveal-2 mt-7 max-w-[13ch]">
          Full Stack Developer building <em class="text-[var(--accent)]">production-ready</em> web apps.
        </h1>

        <p class="reveal reveal-2 mt-8 max-w-[54ch] text-[1.08rem] leading-[1.75] md:text-[1.15rem]">
          I&rsquo;m Awadh Kishor Singh &mdash; I design, build, and ship end-to-end web applications
          with React, Next.js, Node.js, and REST APIs. Data Science undergraduate at IIT Madras, and
          a developer who cares about clean architecture and what users never see.
        </p>

        <!-- CTAs -->
        <div class="reveal reveal-3 mt-9 flex flex-wrap gap-3">
          <a href="/projects" class="btn btn-primary">View work</a>
          <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="btn">Résumé</a>
          <a href="/contact" class="btn btn-ghost">Get in touch</a>
        </div>

        <!-- Socials -->
        <div class="reveal reveal-4 mt-7 flex flex-wrap gap-2">
          {
            socials.map((social) => (
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="chip">
                {social.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- RIGHT: portrait plate -->
      <figure class="reveal reveal-3 plate md:sticky md:top-28">
        <img
          src="https://awadh-portfolio-website.s3.ap-south-1.amazonaws.com/images/awadh-about.webp"
          alt="Portrait of Awadh Kishor Singh"
          loading="eager"
          width="640"
          height="800"
          class="aspect-[4/5] object-cover object-center"
        />
        <figcaption class="plate-caption">
          <span>Bengaluru, IN</span>
          <span class="inline-flex items-center gap-2">
            <span class="pulse"></span>
            Open to work
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ───────────── STATS ───────────── -->
  <section class="wrap mt-20 md:mt-28">
    <div class="grid grid-cols-2 border-y border-[var(--fg)] md:grid-cols-4">
      {
        stats.map((s) => (
          <div class="stat-cell py-7 md:py-9">
            <span class="numeral block text-4xl text-[var(--fg)] md:text-5xl">{s.value}</span>
            <p class="m-0 mt-3 font-mono text-[0.64rem] uppercase leading-relaxed tracking-[0.16em] text-[var(--muted)]">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ───────────── PROFILE SPECIMEN ───────────── -->
  <section class="wrap mt-20 md:mt-28">
    <div class="section-head">
      <div>
        <span class="section-no">01</span>
        <h2 class="mt-3">In short</h2>
      </div>
      <span class="hidden shrink-0 pb-1 font-mono text-[0.64rem] uppercase tracking-[0.16em] text-[var(--muted)] sm:inline">
        The person behind the commits
      </span>
    </div>

    <div class="mt-10 grid gap-x-16 gap-y-8 md:grid-cols-[1fr_1fr]">
      <dl class="m-0 flex flex-col">
        {
          profile.slice(0, 4).map((f) => (
            <div class="flex flex-col gap-1 border-b border-[var(--border)] py-4 sm:flex-row sm:gap-6">
              <dt class="w-32 shrink-0 pt-0.5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--muted)]">
                {f.key}
              </dt>
              <dd class="m-0 text-[0.97rem] text-[var(--fg)]">{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <dl class="m-0 flex flex-col">
        {
          profile.slice(4).map((f) => (
            <div class="flex flex-col gap-1 border-b border-[var(--border)] py-4 sm:flex-row sm:gap-6">
              <dt class="w-32 shrink-0 pt-0.5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--muted)]">
                {f.key}
              </dt>
              <dd class="m-0 text-[0.97rem] text-[var(--fg)]">{f.value}</dd>
            </div>
          ))
        }
        <div class="flex flex-col gap-1 border-b border-[var(--border)] py-4 sm:flex-row sm:gap-6">
          <dt class="w-32 shrink-0 pt-0.5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--muted)]">
            Status
          </dt>
          <dd class="m-0 inline-flex items-center gap-2.5 text-[0.97rem] text-[var(--signal)]">
            <span class="pulse"></span>
            Available for full-stack &amp; SWE roles
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ───────────── FEATURED WORK ───────────── -->
  <section class="wrap mt-20 md:mt-28">
    <div class="section-head">
      <div>
        <span class="section-no">02</span>
        <h2 class="mt-3">Selected work</h2>
      </div>
      <a
        href="/projects"
        class="hidden shrink-0 pb-1 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-[var(--fg-dim)] transition-colors hover:text-[var(--accent)] sm:inline"
      >
        All work &rarr;
      </a>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        featuredProjects.map((p) => (
          <ProjectCard
            index={p.index}
            name={p.name}
            tagline={p.tagline}
            description={p.description}
            tags={p.tags}
            status={p.status}
            live={p.live}
            code={p.code}
            caseStudy={p.caseStudy}
          />
        ))
      }
    </div>

    <a
      href="/projects"
      class="mt-8 inline-flex font-mono text-[0.66rem] uppercase tracking-[0.16em] text-[var(--fg-dim)] transition-colors hover:text-[var(--accent)] sm:hidden"
    >
      All work &rarr;
    </a>
  </section>
</PageLayout>

<style>
  h1 em {
    font-style: italic;
    font-weight: 400;
  }

  /* Stats strip: hairline cells that reflow from 4-up to 2-up. */
  @media (max-width: 767px) {
    .stat-cell:nth-child(even) {
      border-left: 1px solid var(--border);
      padding-left: 1.25rem;
    }
    .stat-cell:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  @media (min-width: 768px) {
    .stat-cell {
      padding-right: 1.75rem;
    }
    .stat-cell + .stat-cell {
      border-left: 1px solid var(--border);
      padding-left: 1.75rem;
    }
  }
</style>
